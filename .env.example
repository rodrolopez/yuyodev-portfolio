# Runtime server-only. Complete locally; never commit real values.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Single bare email addresses, independent of SMTP_USER.
SMTP_FROM=
CONTACT_TO=
TURNSTILE_SECRET_KEY=
# Exact hostname, no protocol/port/path; e.g. localhost locally.
TURNSTILE_EXPECTED_HOSTNAME=
# Must match the widget action (passed from server to browser).
TURNSTILE_EXPECTED_ACTION=
# PUBLIC site key, delivered to the browser at runtime (no build argument).
TURNSTILE_SITE_KEY=
